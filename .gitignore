# ============================================================
# TennineClaw — .gitignore
# ============================================================

# 用户配置（含 API Key）
config/

# Python
__pycache__/
src/__pycache__/
src/tools/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.env.*
venv/
env/
.venv/
ENV/

# Build artifacts
build/
dist/
develop-eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl

# 项目运行数据
sessions/
*.log
logs/
plan.json
plan_snapshots/

# 自定义人格（新增的不上传，只跟踪内置人格）
personas/*/
!personas/严谨工程师/
!personas/创意极客/
!personas/高效助手/

# 自定义技能（新增的不上传，只跟踪内置技能）
skills_custom/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 测试
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/

# 临时文件
temp/
*.tmp
_invest_out/
_*.py
_*.txt
_*.md

# ============================================================
# 打包与构建产物（v1.1.2+ 新增）
# ============================================================

# Inno Setup 安装包输出
installer_output/

# PyInstaller spec 配置文件
*.spec

# 手动创建的语言包（非项目源码，仅用于构建安装包）
Languages/

# 辅助构建脚本（非核心源码）
build_exe.bat
download_inno.bat
