# ============================================================
# TennineClaw — .gitignore
# ============================================================

# 用户配置（含 API Key）
config/user_config.json
user_config.json

# Python
__pycache__/
src/__pycache__/
src/tools/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.env.*
venv/
env/
.venv/
ENV/

# Build artifacts
build/
dist/
develop-eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl

# 项目运行数据
sessions/
*.log
logs/
plan.json
plan_snapshots/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 测试
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/

# 临时文件
temp/
*.tmp
